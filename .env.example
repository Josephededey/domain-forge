# Copy to server/.env. Placeholders only; never commit real values.
NODE_ENV=development
PORT=3001

# Allowed browser origin(s), comma-separated.
CLIENT_URL=http://localhost:5173
PROVIDER_TIMEOUT_MS=5000
SEARCH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_MAX=10
SESSION_TTL_HOURS=168

# Local Postgres from `docker compose up -d db`. The container is published on host port 5433
# so it cannot clash with a Postgres installed directly on your machine.
DATABASE_URL=postgresql://domainforge:change-me@localhost:5433/domainforge

# REQUIRED whenever DATABASE_URL is set (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-generated-value-of-32-plus-chars

# Only for the database tests (throwaway database, shell/CI variable, not needed in server/.env):
#   TEST_DATABASE_URL=postgresql://domainforge:change-me@localhost:5433/domainforge_test

# Deployment only (Render): set TRUST_PROXY_HOPS=2 and PROXY_SHARED_SECRET (16+ chars, same value as the Worker secret).
# TRUST_PROXY_HOPS=1
# PROXY_SHARED_SECRET=
