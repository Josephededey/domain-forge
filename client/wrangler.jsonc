// Cloudflare Worker: serves the built site and proxies /api/* to the API on Render.
{
  "name": "domainforge-web",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Replace with your Render service URL (no trailing slash) before deploying.
    "API_ORIGIN": "https://domainforge-api-nm0d.onrender.com"
  }
  // Secret (not stored here): npx wrangler secret put PROXY_SHARED_SECRET
}
